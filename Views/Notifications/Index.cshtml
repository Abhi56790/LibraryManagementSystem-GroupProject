@model IEnumerable<LibraryManagementSystem.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
}

<h2 class="mb-4">Notification Log</h2>

<p class="text-muted">
    Simulated email and SMS notifications generated by the library system.
</p>
<form asp-action="CheckLoanNotifications"
      method="post"
      class="mb-3">

    <button type="submit" class="btn btn-primary">
        Check Due & Overdue Loans
    </button>
</form>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        No notifications have been generated yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Date</th>
                    <th>Borrower</th>
                    <th>Type</th>
                    <th>Channel</th>
                    <th>Message</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>
                            @item.Borrower.FullName
                        </td>

                        <td>
                            @item.Type
                        </td>

                        <td>
                            @item.Channel
                        </td>

                        <td>
                            @item.Message
                        </td>

                        <td>
                            <span class="badge bg-success">
                                @item.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-controller="Reception"
   asp-action="Index"
   class="btn btn-secondary">
    Back to Reception Dashboard
</a>